MERK_OPERATOR(">", XFX, 800)
MERK_OPERATOR(">=", XFX, 800)
MERK_OPERATOR("@<", XFX, 800)
MERK_OPERATOR("@=<", XFX, 800)
MERK_OPERATOR("@>", XFX, 800)
MERK_OPERATOR("@>=", XFX, 800)
MERK_OPERATOR("\\=", XFX, 800)
MERK_OPERATOR("\\==", XFX, 800)
MERK_OPERATOR("~=", XFX, 800)
MERK_OPERATOR("is", XFX, 799)
MERK_OPERATOR("and", XFY, 780)
MERK_OPERATOR("or", XFY, 760)
