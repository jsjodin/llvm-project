//===----------------------------------------------------------------------===//
//
// The builtin operators of the Mercury 22.01 reference manual, section 2.6,
// in its order, with the current manual's priorities, where a higher priority
// binds more tightly. Each priority is 1500 minus the 22.01 manual's; the
// current manual uses the same numbers for all of these operators. Its two
// additions, '<<u' and '>>u', are not here (design document, "Language
// version"). User-defined operators, `name`, are handled by the term reader.
//
// MERK_OPERATOR(name, specifier, priority)
//
//===----------------------------------------------------------------------===//

MERK_OPERATOR(".", YFX, 1490)
MERK_OPERATOR("!", FX, 1460)
MERK_OPERATOR("!.", FX, 1460)
MERK_OPERATOR("!:", FX, 1460)
MERK_OPERATOR("@", XFX, 1410)
MERK_OPERATOR("^", XFY, 1401)
MERK_OPERATOR("^", FX, 1400)
MERK_OPERATOR("event", FX, 1400)
MERK_OPERATOR(":", YFX, 1380)
MERK_OPERATOR("**", XFY, 1300)
MERK_OPERATOR("-", FX, 1300)
MERK_OPERATOR("\\", FX, 1300)
MERK_OPERATOR("*", YFX, 1100)
MERK_OPERATOR("/", YFX, 1100)
MERK_OPERATOR("//", YFX, 1100)
MERK_OPERATOR("<<", YFX, 1100)
MERK_OPERATOR(">>", YFX, 1100)
MERK_OPERATOR("div", YFX, 1100)
MERK_OPERATOR("mod", XFX, 1100)
MERK_OPERATOR("rem", XFX, 1100)
MERK_OPERATOR("for", XFX, 1000)
MERK_OPERATOR("+", FX, 1000)
MERK_OPERATOR("+", YFX, 1000)
MERK_OPERATOR("++", XFY, 1000)
MERK_OPERATOR("-", YFX, 1000)
MERK_OPERATOR("--", YFX, 1000)
MERK_OPERATOR("/\\", YFX, 1000)
MERK_OPERATOR("\\/", YFX, 1000)
MERK_OPERATOR("..", XFX, 950)
MERK_OPERATOR(":=", XFX, 850)
MERK_OPERATOR("=^", XFX, 850)
MERK_OPERATOR("<", XFX, 800)
MERK_OPERATOR("=", XFX, 800)
MERK_OPERATOR("=..", XFX, 800)
