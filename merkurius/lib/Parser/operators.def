MERK_OPERATOR("~", FY, 600)
MERK_OPERATOR("<=", XFY, 580)
MERK_OPERATOR("<=>", XFY, 580)
MERK_OPERATOR("=>", XFY, 580)
MERK_OPERATOR("all", FXY, 550)
MERK_OPERATOR("arbitrary", FXY, 550)
