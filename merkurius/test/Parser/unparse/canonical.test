# The canonical layout of a carelessly laid out module (Inputs/messy.m),
# which is its own canonical layout. Both modules compile with mmc.
#
# RUN: merkc -fc1 -fdebug-unparse-no-sema %S/Inputs/messy.m \
# RUN:   | diff %S/Inputs/messy.canonical.m -
# RUN: merkc -fc1 -fdebug-unparse-no-sema %S/Inputs/messy.canonical.m \
# RUN:   | diff %S/Inputs/messy.canonical.m -
#
# Loops, with -fdo-loops (design document, "Loops"): ( Iterators do, with
# the iterators on the line of the parenthesis and the body below.
# RUN: merkc -fc1 -fdo-loops -fopenmp -fdebug-unparse-no-sema \
# RUN:   %S/Inputs/loops-messy.m | diff %S/Inputs/loops.canonical.m -
# RUN: merkc -fc1 -fdo-loops -fopenmp -fdebug-unparse-no-sema \
# RUN:   %S/Inputs/loops.canonical.m | diff %S/Inputs/loops.canonical.m -
#
# Receive goals, with -freceive-goal (design document, "Processes and
# mailboxes"): laid out as a disjunction, with each arm's goal below its
# head.
# RUN: merkc -fc1 -freceive-goal -fdebug-unparse-no-sema \
# RUN:   %S/Inputs/receive-messy.m | diff %S/Inputs/receive.canonical.m -
# RUN: merkc -fc1 -freceive-goal -fdebug-unparse-no-sema \
# RUN:   %S/Inputs/receive.canonical.m | diff %S/Inputs/receive.canonical.m -
#
# Process declarations, with -fprocess-declarations (design document,
# "Processes and mailboxes"): message types that do not fit on the line go
# below it, indented.
# RUN: merkc -fc1 -fprocess-declarations -fdebug-unparse-no-sema \
# RUN:   %S/Inputs/processes-messy.m | diff %S/Inputs/processes.canonical.m -
# RUN: merkc -fc1 -fprocess-declarations -fdebug-unparse-no-sema \
# RUN:   %S/Inputs/processes.canonical.m \
# RUN:   | diff %S/Inputs/processes.canonical.m -
#
# With every operator term in parentheses:
# RUN: merkc -fc1 -fdebug-unparse-parenthesized-no-sema %S/Inputs/messy.m \
# RUN:   | FileCheck %s
# CHECK:      {{^}}area(circle(R)) = ((3.14159 * R) * R).{{$}}
# CHECK:      {{^}}    ((Xs = [_, _ | _]),{{$}}
# CHECK-NEXT: {{^}}    (Class = string.format("%d elements", [i(list.length(Xs))])))
