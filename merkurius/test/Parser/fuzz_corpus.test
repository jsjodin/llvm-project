# The fuzz target's checks hold on every Mercury file in the tests, and on
# the inputs in Inputs/fuzz, which once failed them: the tokens unparse to
# the input, and canonical forms read back as themselves. It aborts if one
# does not.
#
# RUN: merkurius-term-fuzzer %S/Inputs/fuzz/*
# RUN: merkurius-term-fuzzer %S/oracle/compounds.m %S/oracle/declarations.m \
# RUN:   %S/oracle/errors.m %S/oracle/numbers.m %S/oracle/operators.m \
# RUN:   %S/../Lexer/tokens.m %S/../Lexer/directives.m \
# RUN:   %S/../Lexer/line_directives.m %S/../Lexer/errors.m \
# RUN:   %S/../../utils/term-oracle/term_oracle.m
