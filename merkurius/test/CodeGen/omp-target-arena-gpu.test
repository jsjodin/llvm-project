The program of omp-target-arena.m, compiled by the driver for the machine's
GPU and run there: the regions' cells come from the device's arena, whose
chunks the host allocates through the offload plugin's RPC server.
REQUIRES: amdgpu-gpu

RUN: merkc -fopenmp -fdo-loops --offload-arch=%offload-arch %libomp-flags %S/omp-target-arena.m -o %t
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY %t \
RUN:   | FileCheck %S/omp-target-arena.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
RUN: merkc -O2 -fopenmp -fdo-loops --offload-arch=%offload-arch %libomp-flags %S/omp-target-arena.m -o %t.O2
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY %t.O2 \
RUN:   | FileCheck %S/omp-target-arena.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
