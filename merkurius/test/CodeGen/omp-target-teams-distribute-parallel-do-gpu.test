The program of omp-target-teams-distribute-parallel-do.m, compiled by the
driver for the machine's GPU and run there: each loop is a kernel whose
iterations the teams and their threads share, and it prints what the
sequential program prints.
REQUIRES: amdgpu-gpu

RUN: merkc -fopenmp -fdo-loops --offload-arch=%offload-arch %libomp-flags %S/omp-target-teams-distribute-parallel-do.m -o %t
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY LIBOMPTARGET_INFO=1 %t 2> %t.info \
RUN:   | FileCheck %S/omp-target-teams-distribute-parallel-do.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
RUN: FileCheck %s < %t.info
CHECK: info: Entering OpenMP kernel at {{.*}}omp-target-teams-distribute-parallel-do.m:{{[0-9]+}}:5 with 4 arguments:
CHECK-NEXT: info: to(N)[8]
CHECK-NEXT: info: tofrom(STATE_VARIABLE_Y_0)[800008]
CHECK-NEXT: info: to(A)[8]
CHECK-NEXT: info: to(X)[800008]
CHECK-COUNT-4: info: Entering OpenMP kernel at {{.*}}omp-target-teams-distribute-parallel-do.m:{{[0-9]+}}:5 with {{[0-9]+}} arguments:
CHECK-NOT: Entering OpenMP kernel
