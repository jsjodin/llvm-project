The program of omp-target-receive-ring.m, compiled by the driver for the
machine's GPU and run there: more messages than the mailbox's ring holds,
taken in order by two regions and the host between them.
REQUIRES: amdgpu-gpu

RUN: merkc -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-receive-ring.m -o %t
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY %t \
RUN:   | FileCheck %S/omp-target-receive-ring.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
RUN: merkc -O2 -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-receive-ring.m -o %t.O2
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY %t.O2 \
RUN:   | FileCheck %S/omp-target-receive-ring.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
