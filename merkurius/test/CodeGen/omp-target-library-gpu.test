The library's procedures on the machine's GPU: omp-target-library.m, whose
target region calls list.length, list.reverse and list.append, copied from
the library's merk bytecode.
REQUIRES: amdgpu-gpu

RUN: merkc -O0 -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-library.m -o %t0
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY %t0 \
RUN:   | FileCheck %S/omp-target-library.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
RUN: merkc -O2 -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-library.m -o %t2
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY %t2 \
RUN:   | FileCheck %S/omp-target-library.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
