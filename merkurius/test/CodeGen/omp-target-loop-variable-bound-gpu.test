The program of omp-target-loop-variable-bound.m, compiled by the driver for
the machine's GPU and run there: the host's kernel call passes the bounds
that are variables, which the device reads.
REQUIRES: amdgpu-gpu

RUN: merkc -fopenmp -fdo-loops --offload-arch=%offload-arch %libomp-flags %S/omp-target-loop-variable-bound.m -o %t
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY LIBOMPTARGET_INFO=1 %t 2> %t.info \
RUN:   | FileCheck %S/omp-target-loop-variable-bound.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
RUN: FileCheck %s < %t.info
RUN: merkc -O2 -fopenmp -fdo-loops --offload-arch=%offload-arch %libomp-flags %S/omp-target-loop-variable-bound.m -o %t.O2
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY LIBOMPTARGET_INFO=1 %t.O2 2> %t.O2.info \
RUN:   | FileCheck %S/omp-target-loop-variable-bound.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
RUN: FileCheck %s < %t.O2.info
CHECK: info: Entering OpenMP kernel at {{.*}}omp-target-loop-variable-bound.m:{{[0-9]+}}:5 with 3 arguments:
CHECK-DAG: info: to(Lo)[8]
CHECK-DAG: info: to(Hi)[8]
CHECK-DAG: info: tofrom(Sum)[8]
