A target teams region on the machine's GPU: omp-target-teams.m, whose teams
each send their number to a mailbox on the host.
REQUIRES: amdgpu-gpu

RUN: merkc -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-teams.m -o %t
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY %t \
RUN:   | FileCheck %S/omp-target-teams.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
