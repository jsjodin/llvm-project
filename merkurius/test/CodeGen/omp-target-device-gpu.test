The device clause on the machine's GPU: omp-target-device.m, device 0.
REQUIRES: amdgpu-gpu

RUN: merkc -O2 -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-device.m -o %t.O2
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY %t.O2 \
RUN:   | FileCheck %S/omp-target-device.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
