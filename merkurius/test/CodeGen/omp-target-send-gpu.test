The program of omp-target-send.m, compiled by the driver for the machine's
GPU and run there: the region's sends go over the offload plugin's RPC
server to the host, which queues them in order before the region ends.
REQUIRES: amdgpu-gpu

RUN: merkc -O2 -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-send.m -o %t.O2
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY LIBOMPTARGET_INFO=1 %t.O2 2> %t.O2.info \
RUN:   | FileCheck %S/omp-target-send.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
RUN: FileCheck %s < %t.O2.info
CHECK: info: Entering OpenMP kernel at {{.*}}omp-target-send.m:{{[0-9]+}}:5 with 6 arguments:
CHECK-NEXT: info: to(region_slot)[8]
CHECK-DAG: info: to(N)[8]
CHECK-DAG: info: to(Ints)[40]
CHECK-DAG: info: to(Floats)[40]
CHECK-DAG: info: to(Chars)[40]
CHECK-DAG: info: to(Colours)[40]
CHECK-NOT: Entering OpenMP kernel
