The program of omp-target-array-made.m, compiled by the driver for the
machine's GPU and run there: the array that the device makes is copied to
the host, by the callback, as the region ends.
REQUIRES: amdgpu-gpu

RUN: merkc -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-array-made.m -o %t
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY timeout -k 1 60 %t \
RUN:   | FileCheck %S/omp-target-array-made.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
RUN: merkc -O2 -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-array-made.m -o %t.O2
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY timeout -k 1 60 %t.O2 \
RUN:   | FileCheck %S/omp-target-array-made.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
