Arrays in team mailboxes on the machine's GPU: omp-target-team-arrays.m,
whose teams pass arrays by their pointer through rings in the device's
memory, more than a ring holds, and change only their own copies.
REQUIRES: amdgpu-gpu

RUN: merkc -O0 -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-team-arrays.m -o %t0
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY %t0 \
RUN:   | FileCheck %S/omp-target-team-arrays.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
RUN: merkc -O2 -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-team-arrays.m -o %t2
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY %t2 \
RUN:   | FileCheck %S/omp-target-team-arrays.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
