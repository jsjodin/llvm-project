Several processes' regions at once on the machine's GPU: process-target-many.m.

REQUIRES: amdgpu-gpu

RUN: merkc -fopenmp --offload-arch=%offload-arch %libomp-flags %S/process-target-many.m -o %t
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY MERK_WORKERS=1 %t \
RUN:   | FileCheck %S/process-target-many.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY %t \
RUN:   | FileCheck %S/process-target-many.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
