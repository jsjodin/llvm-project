Foreign code on the machine's GPU, the module's own and the library's:
omp-target-foreign.m.
REQUIRES: amdgpu-gpu

RUN: merkc -O2 -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-foreign.m -o %t2
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY %t2 \
RUN:   | FileCheck %S/omp-target-foreign.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
