A target region in the module's last procedure on the machine's GPU:
omp-target-last-proc.m.
REQUIRES: amdgpu-gpu

RUN: merkc -O2 -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-last-proc.m -o %t2
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY %t2 \
RUN:   | FileCheck %S/omp-target-last-proc.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
