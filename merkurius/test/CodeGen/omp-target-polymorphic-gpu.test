The program of omp-target-polymorphic.m, compiled by the driver for the
machine's GPU and run there.
REQUIRES: amdgpu-gpu

RUN: merkc -fopenmp -fdo-loops --offload-arch=%offload-arch %libomp-flags %S/omp-target-polymorphic.m -o %t
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY %t | FileCheck %S/omp-target-polymorphic.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
