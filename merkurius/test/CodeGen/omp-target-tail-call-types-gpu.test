The program of omp-target-tail-call-types.m, compiled by the driver for the
machine's GPU and run there.
REQUIRES: amdgpu-gpu

RUN: merkc -O2 -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-tail-call-types.m -o %t.O2
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY timeout -k 1 60 %t.O2 \
RUN:   | FileCheck %S/omp-target-tail-call-types.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
