The program of omp-target-array-operations.m, compiled by the driver for
the machine's GPU and run there.
REQUIRES: amdgpu-gpu

RUN: merkc -O2 -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-array-operations.m -o %t.O2
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY timeout -k 1 60 %t.O2 \
RUN:   | FileCheck %S/omp-target-array-operations.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
