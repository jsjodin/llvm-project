The program of omp-target-send-call.m, compiled by the driver for the
machine's GPU and run there: a procedure that the region calls sends, by
its message type's key.
REQUIRES: amdgpu-gpu

RUN: merkc -O2 -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-send-call.m -o %t.O2
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY %t.O2 \
RUN:   | FileCheck %S/omp-target-send-call.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
