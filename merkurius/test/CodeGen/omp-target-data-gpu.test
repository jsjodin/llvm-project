The program of omp-target-data.m on the machine's GPU: an array is copied to the
device when its region starts and back when it ends, and the kernels in between
copy none of it, though their own maps name it.
REQUIRES: amdgpu-gpu

RUN: merkc -O2 -fopenmp -fdo-loops --offload-arch=%offload-arch %libomp-flags %S/omp-target-data.m -o %t
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY LIBOMPTARGET_INFO=32 %t 2> %t.info \
RUN:   | FileCheck %S/omp-target-data.m --check-prefix=OUTPUT --match-full-lines
RUN: FileCheck %s < %t.info
CHECK: Copying data from host to device, {{.*}}Size={{[0-9]+}}, Name=A, at {{.*}}omp-target-data.m:[[REGION:[0-9]+]]:
CHECK-NOT: Name=STATE_VARIABLE_A
CHECK-NOT: Name=B
CHECK: Copying data from device to host, {{.*}}Size={{[0-9]+}}, Name=A, at {{.*}}omp-target-data.m:[[REGION]]:
