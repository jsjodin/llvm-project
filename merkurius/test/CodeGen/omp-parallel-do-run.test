The program of omp-parallel-do.m, compiled by the driver with libomp and
run on four threads; it prints what the sequential program prints.
REQUIRES: libomp

RUN: merkc -fopenmp -fdo-loops %libomp-flags %S/omp-parallel-do.m -o %t
RUN: %libomp-env OMP_NUM_THREADS=4 %t \
RUN:   | FileCheck %S/omp-parallel-do.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
RUN: merkc -fdo-loops %S/omp-parallel-do.m -o %t.sequential
RUN: %t.sequential \
RUN:   | FileCheck %S/omp-parallel-do.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
