The program of omp-target-enum-output.m on the machine's GPU.
REQUIRES: amdgpu-gpu

RUN: merkc -O2 -fopenmp --offload-arch=%offload-arch %libomp-flags %S/omp-target-enum-output.m -o %t.O2
RUN: %libomp-env OMP_TARGET_OFFLOAD=MANDATORY timeout -k 1 60 %t.O2 \
RUN:   | FileCheck %S/omp-target-enum-output.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
