@LIT_SITE_CFG_IN_HEADER@

config.llvm_tools_dir = lit_config.substitute("@LLVM_TOOLS_DIR@")
config.merkurius_src_root = "@MERKURIUS_SOURCE_DIR@"
config.merkurius_obj_root = "@MERKURIUS_BINARY_DIR@"
config.merkurius_tools_dir = lit_config.substitute("@LLVM_RUNTIME_OUTPUT_INTDIR@")
config.merkurius_gtest_avail = @MERKURIUS_GTEST_AVAIL@
config.python_executable = "@Python3_EXECUTABLE@"

import lit.llvm
lit.llvm.initialize(lit_config, config)

# Let the main config do the real work.
lit_config.load_config(config, "@MERKURIUS_SOURCE_DIR@/test/lit.cfg.py")
