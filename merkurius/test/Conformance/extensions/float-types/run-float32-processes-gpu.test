run-float32-processes.m's scaler spawned on the machine's GPU, which
answers with the float32s it answers with at the host, the output the C
translation gives.
REQUIRES: amdgpu-gpu

RUN: merkc -O2 -fprocess-declarations --offload-arch=%offload-arch %libomp-flags %S/run-float32-processes.m -o %t2
RUN: %gpu-env timeout -k 1 60 %t2 gpu 2>&1 | FileCheck %S/run-float32-processes.m --check-prefix=OUTPUT --match-full-lines --strict-whitespace
