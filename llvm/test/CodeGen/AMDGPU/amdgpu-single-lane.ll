; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -mtriple=amdgpu10.30-amd-amdhsa -passes=amdgpu-single-lane < %s | FileCheck %s
; RUN: llc -mtriple=amdgpu10.30-amd-amdhsa < %s | FileCheck %s --check-prefix=ISA

; A function marked "amdgpu-single-lane" runs with one active lane, so the
; values that are divergent at their sources (arguments, loads through flat
; and private pointers, calls' results, atomics) are read from the first
; active lane, and what is computed from them is uniform.

declare i64 @callee(i64)
declare { i64, i1 } @pair(i64)

; The branch on the loaded value is uniform: a branch on vcc, with no exec
; masking, and the call's result is added in scalar registers.
; ISA-LABEL: branch:
; ISA:         flat_load_dwordx2 v[[[LO:[0-9]+]]:[[HI:[0-9]+]]]
; ISA-DAG:     v_readfirstlane_b32 s{{[0-9]+}}, v[[LO]]
; ISA-DAG:     v_readfirstlane_b32 s{{[0-9]+}}, v[[HI]]
; ISA-NOT:     exec
; ISA:         s_cbranch_vccnz
; ISA:         s_swappc_b64
; ISA-NEXT:    v_readfirstlane_b32 [[R:s[0-9]+]], v0
; ISA:         s_add_u32 [[R]], [[R]], 1
define i64 @branch(ptr %p, i64 %n) "amdgpu-single-lane" {
; CHECK-LABEL: define i64 @branch(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @llvm.amdgcn.readfirstlane.p0(ptr [[P]])
; CHECK-NEXT:    [[TMP1:%.*]] = call i64 @llvm.amdgcn.readfirstlane.i64(i64 [[N]])
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[TMP0]], align 8
; CHECK-NEXT:    [[TMP2:%.*]] = call i64 @llvm.amdgcn.readfirstlane.i64(i64 [[V]])
; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[TMP2]], [[TMP1]]
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[ELSE:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[R:%.*]] = call i64 @callee(i64 [[TMP2]])
; CHECK-NEXT:    [[TMP3:%.*]] = call i64 @llvm.amdgcn.readfirstlane.i64(i64 [[R]])
; CHECK-NEXT:    [[S:%.*]] = add i64 [[TMP3]], 1
; CHECK-NEXT:    ret i64 [[S]]
; CHECK:       [[ELSE]]:
; CHECK-NEXT:    ret i64 [[TMP1]]
;
entry:
  %v = load i64, ptr %p
  %c = icmp slt i64 %v, %n
  br i1 %c, label %then, label %else
then:
  %r = call i64 @callee(i64 %v)
  %s = add i64 %r, 1
  ret i64 %s
else:
  ret i64 %n
}

; A tail call's result, which only the return uses, is left as it is.
define i64 @tail(i64 %x) "amdgpu-single-lane" {
; CHECK-LABEL: define i64 @tail(
; CHECK-SAME: i64 [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[TMP1:%.*]] = call i64 @llvm.amdgcn.readfirstlane.i64(i64 [[X]])
; CHECK-NEXT:    [[R:%.*]] = tail call i64 @callee(i64 [[TMP1]])
; CHECK-NEXT:    ret i64 [[R]]
;
  %r = tail call i64 @callee(i64 %x)
  ret i64 %r
}

; An aggregate's parts are read where they are extracted.
define i64 @aggregate(i64 %x, ptr addrspace(5) %q) "amdgpu-single-lane" {
; CHECK-LABEL: define i64 @aggregate(
; CHECK-SAME: i64 [[X:%.*]], ptr addrspace(5) [[Q:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[TMP1:%.*]] = call i64 @llvm.amdgcn.readfirstlane.i64(i64 [[X]])
; CHECK-NEXT:    [[TMP2:%.*]] = call ptr addrspace(5) @llvm.amdgcn.readfirstlane.p5(ptr addrspace(5) [[Q]])
; CHECK-NEXT:    [[P:%.*]] = call { i64, i1 } @pair(i64 [[TMP1]])
; CHECK-NEXT:    [[V:%.*]] = extractvalue { i64, i1 } [[P]], 0
; CHECK-NEXT:    [[TMP3:%.*]] = call i64 @llvm.amdgcn.readfirstlane.i64(i64 [[V]])
; CHECK-NEXT:    [[B:%.*]] = extractvalue { i64, i1 } [[P]], 1
; CHECK-NEXT:    [[TMP4:%.*]] = call i1 @llvm.amdgcn.readfirstlane.i1(i1 [[B]])
; CHECK-NEXT:    [[L:%.*]] = load i8, ptr addrspace(5) [[TMP2]], align 1
; CHECK-NEXT:    [[TMP5:%.*]] = call i8 @llvm.amdgcn.readfirstlane.i8(i8 [[L]])
; CHECK-NEXT:    [[Z:%.*]] = zext i8 [[TMP5]] to i64
; CHECK-NEXT:    [[W:%.*]] = add i64 [[TMP3]], [[Z]]
; CHECK-NEXT:    [[S:%.*]] = select i1 [[TMP4]], i64 [[W]], i64 0
; CHECK-NEXT:    ret i64 [[S]]
;
  %p = call { i64, i1 } @pair(i64 %x)
  %v = extractvalue { i64, i1 } %p, 0
  %b = extractvalue { i64, i1 } %p, 1
  %l = load i8, ptr addrspace(5) %q
  %z = zext i8 %l to i64
  %w = add i64 %v, %z
  %s = select i1 %b, i64 %w, i64 0
  ret i64 %s
}

; Atomics' results, and loads in a loop, read at the phi's block's start.
define i32 @atomic(ptr %p) "amdgpu-single-lane" {
; CHECK-LABEL: define i32 @atomic(
; CHECK-SAME: ptr [[P:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @llvm.amdgcn.readfirstlane.p0(ptr [[P]])
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[TMP1:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[OLD:%.*]] = atomicrmw add ptr [[TMP0]], i32 1 monotonic, align 4
; CHECK-NEXT:    [[TMP1]] = call i32 @llvm.amdgcn.readfirstlane.i32(i32 [[OLD]])
; CHECK-NEXT:    [[DONE:%.*]] = icmp sge i32 [[TMP1]], [[I]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 [[TMP1]]
;
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %old, %loop ]
  %old = atomicrmw add ptr %p, i32 1 monotonic
  %done = icmp sge i32 %old, %i
  br i1 %done, label %exit, label %loop
exit:
  ret i32 %old
}

; A global load, which is uniform for uniform addresses, and a function
; without the attribute, are left as they are.
define i32 @unmarked(ptr %p, ptr addrspace(1) %g) {
; CHECK-LABEL: define i32 @unmarked(
; CHECK-SAME: ptr [[P:%.*]], ptr addrspace(1) [[G:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    [[W:%.*]] = load i32, ptr addrspace(1) [[G]], align 4
; CHECK-NEXT:    [[S:%.*]] = add i32 [[V]], [[W]]
; CHECK-NEXT:    ret i32 [[S]]
;
  %v = load i32, ptr %p
  %w = load i32, ptr addrspace(1) %g
  %s = add i32 %v, %w
  ret i32 %s
}
