; "no_callee_saved_registers" on a kernel goes to each local function that
; only it, or functions that have or get it, call directly: they keep no
; register for each other, and IPRA's masks have each call keep what its
; caller needs across it.

declare void @external()

; Called only from the kernel with it, and from itself.
define internal void @under(i32 %n) {
; CHECK-LABEL: define internal void @under(
; CHECK-SAME: i32 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[C:%.*]] = icmp eq i32 [[N]], 0
; CHECK-NEXT:    br i1 [[C]], label %[[DONE:.*]], label %[[AGAIN:.*]]
; CHECK:       [[AGAIN]]:
; CHECK-NEXT:    [[M:%.*]] = sub i32 [[N]], 1
; CHECK-NEXT:    call void @under(i32 [[M]])
; CHECK-NEXT:    call void @under_under()
; CHECK-NEXT:    br label %[[DONE]]
; CHECK:       [[DONE]]:
; CHECK-NEXT:    ret void
;
  %c = icmp eq i32 %n, 0
  br i1 %c, label %done, label %again
again:
  %m = sub i32 %n, 1
  call void @under(i32 %m)
  call void @under_under()
  br label %done
done:
  ret void
}

; Called only from a function that gets it.
define internal void @under_under() {
; CHECK-LABEL: define internal void @under_under(
; CHECK-SAME: ) #[[ATTR0]] {
; CHECK-NEXT:    call void @external()
; CHECK-NEXT:    ret void
;
  call void @external()
  ret void
}

; Called from both kernels: an ordinary caller would save all its own
; callee-saved registers around it.
define internal void @shared() {
; CHECK-LABEL: define internal void @shared() {
; CHECK-NEXT:    call void @shared_under()
; CHECK-NEXT:    ret void
;
  call void @shared_under()
  ret void
}

; Called only from a function that does not get it.
define internal void @shared_under() {
; CHECK-LABEL: define internal void @shared_under() {
; CHECK-NEXT:    call void @external()
; CHECK-NEXT:    ret void
;
  call void @external()
  ret void
}

; Its address is taken, so it may have callers that are not seen.
define internal void @address_taken() {
; CHECK-LABEL: define internal void @address_taken(
; CHECK-SAME: ) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:    ret void
;
  ret void
}

; Not local, so it may have callers in other modules.
define void @not_local() {
; CHECK-LABEL: define void @not_local(
; CHECK-SAME: ) #[[ATTR1]] {
; CHECK-NEXT:    ret void
;
  ret void
}

define amdgpu_kernel void @kernel_no_csr(ptr addrspace(1) %out) "no_callee_saved_registers" {
; CHECK-LABEL: define amdgpu_kernel void @kernel_no_csr(
; CHECK-SAME: ptr addrspace(1) [[OUT:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    call void @under(i32 3)
; CHECK-NEXT:    call void @shared()
; CHECK-NEXT:    call void @not_local()
; CHECK-NEXT:    store ptr @address_taken, ptr addrspace(1) [[OUT]], align 8
; CHECK-NEXT:    ret void
;
  call void @under(i32 3)
  call void @shared()
  call void @not_local()
  store ptr @address_taken, ptr addrspace(1) %out
  ret void
}

define amdgpu_kernel void @kernel() {
; CHECK-LABEL: define amdgpu_kernel void @kernel() {
; CHECK-NEXT:    call void @shared()
; CHECK-NEXT:    ret void
;
  call void @shared()
  ret void
}
