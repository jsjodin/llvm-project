; A call of llvm.amdgcn.call.whole.wave runs only its callee, its first
; operand, rather than anything an intrinsic without nocallback might call
; back: the caller's AGPRs and LDS DMA follow from the callee's, as for a
; direct call, and it needs no implicit arguments, since a whole-wave
; callee is passed none.

; The callee needs nothing, so neither does the caller.
define amdgpu_gfx_whole_wave void @plain(i1 %active, ptr addrspace(1) inreg %p, i32 inreg %v) {
; CHECK-LABEL: define amdgpu_gfx_whole_wave void @plain(
; CHECK-SAME: i1 [[ACTIVE:%.*]], ptr addrspace(1) inreg [[P:%.*]], i32 inreg [[V:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    store i32 [[V]], ptr addrspace(1) [[P]], align 4
; CHECK-NEXT:    ret void
;
  store i32 %v, ptr addrspace(1) %p
  ret void
}

define void @calls_plain(ptr addrspace(1) %p, i32 %v) {
; CHECK-LABEL: define void @calls_plain(
; CHECK-SAME: ptr addrspace(1) [[P:%.*]], i32 [[V:%.*]]) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:    call void (ptr, ...) @llvm.amdgcn.call.whole.wave.isVoid.p0(ptr @plain, ptr addrspace(1) inreg [[P]], i32 inreg [[V]])
; CHECK-NEXT:    ret void
;
  call void (ptr, ...) @llvm.amdgcn.call.whole.wave(ptr @plain, ptr addrspace(1) inreg %p, i32 inreg %v)
  ret void
}

; The callee's inline assembly names an AGPR, so the caller needs one.
define amdgpu_gfx_whole_wave void @uses_agpr(i1 %active) {
; CHECK-LABEL: define amdgpu_gfx_whole_wave void @uses_agpr(
; CHECK-SAME: i1 [[ACTIVE:%.*]]) #[[ATTR2:[0-9]+]] {
; CHECK-NEXT:    call void asm sideeffect "
; CHECK-NEXT:    ret void
;
  call void asm sideeffect "; use $0", "a"(i32 0)
  ret void
}

define void @calls_uses_agpr() {
; CHECK-LABEL: define void @calls_uses_agpr(
; CHECK-SAME: ) #[[ATTR3:[0-9]+]] {
; CHECK-NEXT:    call void (ptr, ...) @llvm.amdgcn.call.whole.wave.isVoid.p0(ptr @uses_agpr)
; CHECK-NEXT:    ret void
;
  call void (ptr, ...) @llvm.amdgcn.call.whole.wave(ptr @uses_agpr)
  ret void
}

; A kernel through a function with a whole-wave call, as a GPU process's
; kernel reaches a wave's copy.
define amdgpu_kernel void @kernel(ptr addrspace(1) %p, i32 %v) {
; CHECK-LABEL: define amdgpu_kernel void @kernel(
; CHECK-SAME: ptr addrspace(1) [[P:%.*]], i32 [[V:%.*]]) #[[ATTR1]] {
; CHECK-NEXT:    call void @calls_plain(ptr addrspace(1) [[P]], i32 [[V]])
; CHECK-NEXT:    ret void
;
  call void @calls_plain(ptr addrspace(1) %p, i32 %v)
  ret void
}

